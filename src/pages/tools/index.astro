---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { TOOLS } from "../../config/tools";
import { site } from "../../config/site";
---

<BaseLayout
  title={`Tools · ${site.shortName}`}
  description="Interactive tools from Sherman-Davison Business Solutions."
  path="/tools"
>
  <SiteHeader />
  <main id="main" class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="section-label mb-4">Tools</p>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-5xl">Toolkit</h1>
    <p class="mt-4 text-muted">
      Small utilities you can use today. Add more by dropping an entry in
      <code class="font-mono text-cyan">src/config/tools.ts</code>.
    </p>
    <ul class="mt-10 space-y-4">
      {
        TOOLS.map((tool) => (
          <li class="glass glass-hover rounded-2xl p-5">
            <a href={`/tools/${tool.slug}`} class="block">
              <div class="flex items-center justify-between gap-3">
                <h2 class="text-lg font-medium">{tool.name}</h2>
                {!tool.ready ? (
                  <span class="font-mono text-[10px] uppercase tracking-wider text-warn">soon</span>
                ) : null}
              </div>
              <p class="mt-2 text-sm text-muted">{tool.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
  <SiteFooter />
</BaseLayout>
