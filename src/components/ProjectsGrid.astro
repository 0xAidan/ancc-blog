---
import { getVisibleProjects } from "../config/projects";
import ProjectCard from "./ProjectCard.astro";

const projects = getVisibleProjects();
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="projects-heading">
  <h2 id="projects-heading" class="section-label mb-6">Projects</h2>
  <ul class="grid gap-4 sm:grid-cols-2">
    {
      projects.map((project) => (
        <li>
          <ProjectCard project={project} />
        </li>
      ))
    }
  </ul>
</section>
