---
import type { Project } from "../config/projects";

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<a
  href={`/projects/${project.slug}`}
  class="glass glass-hover group flex h-full flex-col gap-3 rounded-2xl p-5 focus-visible:outline-cyan"
  aria-label={`${project.name}: ${project.description}`}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold tracking-tight group-hover:text-cyan">{project.name}</h3>
    <span class="status-dot mt-2 shrink-0" data-status="up" data-project-status={project.id} aria-hidden="true"></span>
  </div>
  <p class="font-mono text-xs text-faint" translate="no">{project.domain}</p>
  <p class="text-sm text-muted">{project.description}</p>
  <ul class="mt-auto flex flex-wrap gap-2 pt-2">
    {
      project.tags.map((tag) => (
        <li class="rounded-full border border-border px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-faint">
          {tag}
        </li>
      ))
    }
  </ul>
</a>
