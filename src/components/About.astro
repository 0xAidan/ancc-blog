---
import { site } from "../config/site";
---

<section id="about" class="mx-auto max-w-6xl px-4 py-16 sm:px-6" aria-labelledby="about-heading">
  <h2 id="about-heading" class="section-label mb-6">About</h2>
  <div class="glass rounded-2xl p-6 sm:p-8">
    <p class="max-w-3xl text-base leading-relaxed text-muted sm:text-lg">
      {site.name} is a small studio for systems that feel futuristic and stay
      useful — live dashboards, models you can inspect, and tools you can extend.
      The vibe is informal. The work is serious.
    </p>
  </div>
</section>
